# Neon PostgreSQL configuration for Prisma
# Use Vercel's Prisma-compatible pooled connection string for the application runtime.
POSTGRES_PRISMA_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# Use Vercel's direct (non-pooled) connection string for Prisma migrations.
POSTGRES_DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require